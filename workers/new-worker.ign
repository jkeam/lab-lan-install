{
  "ignition":{
    "version":"3.2.0",
    "config":{
      "merge":[
        {
          "source":"https://httpd-server-cluster-services.apps.lab.keam.org/images/worker.ign"
        }
      ]
    }
  },
  "storage":{
    "files":[
      {
        "path":"/etc/hostname",
        "contents":{
          "source":"data:,worker1.lab.keam.org"
        },
        "mode":420,
        "overwrite":true,
        "path":"/etc/hostname"
      }
    ]
  }
}
